  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>LangSpark</name>
  <summary>Offline-first vocabulary and pronunciation practice</summary>
  <description>
    <p>
      LangSpark is a native, offline-first vocabulary application combining
      spaced repetition (SM-2) with language-aware pronunciation practice.
      It supports Japanese (with kanji lookup via JMdict/Kanjidic) and
      Spanish, with an architecture designed to support additional
      languages one at a time.
    </p>
  </description>
  <launchable type="desktop-id">org.langspark.LangSpark.desktop</launchable>
